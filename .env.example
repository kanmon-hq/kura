# ==============================================================================
# Kura - Environment Configuration Example (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# サーバー & インフラ設定
# ------------------------------------------------------------------------------
PORT=8080
AWS_REGION=ap-northeast-1

# ストレージバックエンド種別の指定 (未指定時の既定値: sqlite)
# COST_STORE: sqlite | dynamodb | cosmosdb | firestore | valkey | redis
# USAGE_STORE: sqlite | dynamodb | cosmosdb | firestore
COST_STORE=sqlite
USAGE_STORE=sqlite

# SQLite 接続設定 (単一ノード標準構成)
SQLITE_PATH=./data/kura.db

# DynamoDB 接続設定 (COST_STORE/USAGE_STORE=dynamodb 時)
DYNAMODB_ENDPOINT=http://dynamodb:8000
DYNAMODB_TABLE_NAME=KuraUsage

# Azure Cosmos DB 接続設定 (COST_STORE/USAGE_STORE=cosmosdb 時)
# COSMOSDB_ENDPOINT=https://<your-account>.documents.azure.com:443/
# COSMOSDB_KEY=<your-primary-key>
# COSMOSDB_CONNECTION_STRING=AccountEndpoint=https://...;AccountKey=...;
COSMOSDB_DATABASE=kura
COSMOSDB_CONTAINER=usage

# Google Cloud Firestore 接続設定 (COST_STORE/USAGE_STORE=firestore 時)
# FIRESTORE_PROJECT_ID=<your-gcp-project-id>
FIRESTORE_DATABASE=(default)

# Valkey / Redis 接続設定 (COST_STORE=valkey または redis 時)
VALKEY_URL=redis://localhost:6379/0
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 信頼済みゲートウェイ共有シークレット設定
# ※ 本番環境では 32文字以上のランダム文字列（例: openssl rand -hex 32）を設定してください。
# ※ 未設定時は起動時にエラー（Fail-Fast）となります。
# ※ ローカル開発・テスト時のみ INSECURE_NO_GATEWAY_AUTH=true で検証をスキップできます。
# ------------------------------------------------------------------------------
GATEWAY_SHARED_SECRET=
# GATEWAY_SHARED_SECRET_PREVIOUS=  # ゼロダウンタイム・ローテーション時の旧シークレット
# GATEWAY_SECRET_HEADER=X-Gateway-Secret
INSECURE_NO_GATEWAY_AUTH=false

# ------------------------------------------------------------------------------
# キャッシュ層設定 (DynamoDB / PostgreSQL / Valkey 等の前段最適化)
# ※ SQLite 構成では自動的にバイパスされます
# ------------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_NEGATIVE_TTL_SECONDS=300
CACHE_CONFIG_TTL_SECONDS=60
CACHE_BALANCE_TTL_SECONDS=0
CACHE_BATCH_FLUSH_INTERVAL_SECONDS=0

# 単価表 JSON ファイルパス (起動時スキーマ検証)
PRICING_FILE=pricing.json

# 未知モデル呼び出し時のポリシー (warn: デフォルト単価でフォールバックして集計 / reject: 400エラーで即座に拒絶)
UNKNOWN_MODEL_POLICY=warn

# Valkey/Redis 利用時の集計補正ジョブ定期実行間隔 (秒、デフォルト: 300)
RECONCILE_INTERVAL_SECONDS=300

# 管理者用 API キー (Admin API 認証用)
ADMIN_API_KEY=

# 月次トークン上限デフォルト値 (初期チーム用)
DEFAULT_TOKEN_QUOTA=1000000

# ゲートウェイプロキシ認証強制フラグ (true: X-Key-ID が必須、false: 直接呼び出し許容)
ENFORCE_TOLLGATE_AUTH=false

# 定期バッチジョブの自動実行 (月次レポート・予算アラート・補正)
ENABLE_INTERNAL_CRON=true

# Scalar API ドキュメント UI パス (空文字または off/none で無効化)
DOCS_PATH=/docs

# OpenAPI 3.1 仕様書エンドポイント パス (空文字または off/none で無効化)
OPENAPI_PATH=/openapi

# ------------------------------------------------------------------------------
# 各 LLM プロバイダ設定
# ※ 使用しないプロバイダは空文字のままでOK（自動的に無効化されます）
# ------------------------------------------------------------------------------

# --- Microsoft Foundry / Azure OpenAI ---
# グローバルエンドポイント (例: https://your-resource.openai.azure.com/openai/v1)
MICROSOFT_FOUNDRY_ENDPOINT=
# 日本国内限定エンドポイント (X-Data-Residency: japan 指定時に使用、例: Japan East)
MICROSOFT_FOUNDRY_ENDPOINT_JAPAN=
# Foundry API キー
MICROSOFT_FOUNDRY_API_KEY=
# API バージョン
MICROSOFT_FOUNDRY_API_VERSION=2024-02-15-preview
# 未指定時のデフォルトデプロイメント名 (例: gpt-5.4-mini)
MICROSOFT_FOUNDRY_DEFAULT_DEPLOYMENT=

# --- Amazon Bedrock (bedrock-mantle / OpenAI 互換) ---
BEDROCK_API_KEY=
BEDROCK_REGION=us-east-1
# BEDROCK_ENDPOINT=https://bedrock-mantle.us-east-1.api.aws/v1

# --- Google Gemini (Google AI Studio) ---
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
